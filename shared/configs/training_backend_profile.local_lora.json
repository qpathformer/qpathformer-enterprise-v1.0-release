{
  "backend_profile_version": "v14.3",
  "backend_profile_id": "local_lora_reference",
  "backend": "local_lora",
  "supported_backends": [
    "local_lora"
  ],
  "compatible_package_states": [
    "STATE_1"
  ],
  "format": "sft_jsonl",
  "prompt_field": "prompt",
  "completion_field": "completion",
  "include_metadata": true,
  "execution_mode": "configured",
  "model": {
    "model_base": "TinyLlama/TinyLlama-1.1B-Chat-v1.0",
    "model_family": "llama"
  },
  "default_hyperparameters": {
    "max_steps": 100,
    "learning_rate": 5e-5,
    "batch_size": 1
  },
  "backend_config": {
    "device": "auto",
    "seed": 42,
    "max_seq_len": 512,
    "num_train_epochs": 1.0,
    "gradient_accumulation_steps": 4,
    "warmup_steps": 0,
    "logging_steps": 1,
    "save_steps": 50,
    "save_total_limit": 2,
    "lora_r": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.05,
    "target_modules": [
      "q_proj",
      "v_proj"
    ],
    "fp16": false,
    "bf16": false,
    "gradient_checkpointing": false,
    "trust_remote_code": false
  },
  "notes": "Reference local LoRA backend profile for v14 real execution. Update model.model_base to the locally available base model before production runs. Requires torch, transformers, datasets, peft, and accelerate."
}
